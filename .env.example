# Ronaq Production Environment Variables
SECRET_KEY=generate-a-secure-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=13.205.9.221,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://13.205.9.221,https://13.205.9.221
FRONTEND_URL=http://13.205.9.221
BASE_URL=http://13.205.9.221

# PostgreSQL Database Configuration
POSTGRES_DB=ronaq_db
POSTGRES_USER=ronaq_user
POSTGRES_PASSWORD=generate_a_strong_password_here

# Email Configuration (Optional - For notifications & order emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Ronaq Luxury <no-reply@ronaq.com>

# Backup Retention
BACKUP_KEEP_DAYS=14
